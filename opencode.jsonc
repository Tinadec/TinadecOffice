{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail@4.8.4"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "shadcnVue": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "shadcn-vue@latest",
        "mcp"
      ],
      "cwd": "apps/desktop"
    },
    "vue-mcp": {
      "type": "sse",
      "enabled": true,
      "url": "http://localhost:5173/__mcp/sse"
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "electron": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "electron-mcp-server"
      ],
      "env": {
        "SECURITY_LEVEL": "balanced",
        "SCREENSHOT_ENCRYPTION_KEY": "a5e12db109ad3a1f061246984b9e35badf168c164eb205340234de762bad93ce"
      }
    }
  }
}
