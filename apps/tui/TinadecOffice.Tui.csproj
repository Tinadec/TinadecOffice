<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TinadecOffice.Tui</RootNamespace>
    <AssemblyName>TinadecOffice.Tui</AssemblyName>
    <Description>Terminal.Gui TUI client for TinadecOffice. Welcome page first.</Description>
    <!-- Override system env var Version=V7.24.42SP3 set by Android SDK (same as TinadecCore). -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>

</Project>
