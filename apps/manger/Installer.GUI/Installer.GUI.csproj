<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tinadec.Installer.GUI</RootNamespace>
    <AssemblyName>Tinadec.Installer.GUI</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    NativeAOT publish profile (use at publish time, not required for dev build):
      dotnet publish -c Release -r win-x64 /p:PublishAot=true /p:MewUIBackend=Direct2D
    The Aprillz.MewUI metapackage carries every platform host + backend; the
    MewUIBackend/RuntimeIdentifier properties filter what gets packaged.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <SelfContained>true</SelfContained>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <NoWarn>$(NoWarn);IL2101;IL2072;IL2075</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MewUI all-in-one metapackage (Core + all platform hosts + rendering backends) -->
    <PackageReference Include="Aprillz.MewUI" Version="0.19.1" />

    <!-- DI container -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- Shared installer engine -->
    <ProjectReference Include="..\Installer.Core\Installer.Core.csproj" />
  </ItemGroup>

</Project>
