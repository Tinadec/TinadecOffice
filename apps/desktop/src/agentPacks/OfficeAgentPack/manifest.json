{
  "api_version": "tinadec.io/agent-pack/v1alpha1",
  "kind": "AgentPack",
  "metadata": {
    "pack_id": "tinadec.office.agent-pack",
    "owner": "tinadec.office",
    "product_id": "tinadec.office",
    "name": "OfficeAgentPack",
    "version": "0.2.3"
  },
  "compatibility": {
    "minimum_core_version": "0.1.0",
    "required_core_capabilities": [
      "agent_pack_lifecycle",
      "versioned_agent_configuration",
      "frozen_agent_version_binding"
    ]
  },
  "resources": {
    "agents": [
      {
        "resource_key": "meeting",
        "slug": "meeting",
        "display_name": "会议智能体",
        "description": "用户与系统的唯一对话入口，理解意图、拆解任务并派发执行。",
        "layer": "operation",
        "role": "session_coordinator",
        "capabilities": ["user.respond", "task.dispatch", "agent.create_temporary", "agent.create_persistent", "agent.create_profile"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": [],
        "system_prompt": "你是用户与系统的唯一对话入口。负责理解用户意图、拆解任务并按双层治理派发给执行层；对用户保持简洁、可执行的表达，汇报时先结论后依据。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:meeting-prompt"
      },
      {
        "resource_key": "context_compressor",
        "slug": "context_compressor",
        "display_name": "上下文压缩智能体",
        "description": "实时压缩会话上下文，保留任务关键证据。",
        "layer": "operation",
        "role": "context_maintenance",
        "capabilities": ["context.read", "context.patch"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": [],
        "system_prompt": "你擅长长文本提炼。在保留任务目标、已确认事实与未完成事项的前提下，把冗余对话压缩为结构化摘要；绝不丢弃审批与工具调用结论。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:baseline-prompt"
      },
      {
        "resource_key": "skill_recommender",
        "slug": "skill_recommender",
        "display_name": "技能推荐智能体",
        "description": "为任务匹配合适的工具与技能组合。",
        "layer": "operation",
        "role": "capability_advisor",
        "capabilities": ["tool.search", "agent.propose"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": [],
        "system_prompt": "你是技能推荐智能体。根据任务目标、约束和当前可用能力，给出最小充分的技能与工具组合、适用理由和风险提示；你不直接执行任务、不批准权限，也不直接面向用户输出，建议必须交给会议或规划智能体决策。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:baseline-prompt"
      },
      {
        "resource_key": "supervisor",
        "slug": "supervisor",
        "display_name": "监督智能体",
        "description": "质检各智能体的产出，并在授权额度内代批低风险权限请求。",
        "layer": "operation",
        "role": "quality_controller",
        "capabilities": ["supervision.review"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": [],
        "system_prompt": "你是质量与合规的把关者。审查执行层智能体的计划与结果，发现偏差即打回并给出修正指令；在用户已授予委托额度时可为低风险权限请求代批，超出额度必须上报用户，绝不越权。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:supervisor-prompt"
      },
      {
        "resource_key": "evolution",
        "slug": "evolution",
        "display_name": "进化智能体",
        "description": "从运行经验中提出新的智能体配置候选，供用户决定是否持久化。",
        "layer": "operation",
        "role": "experience_curator",
        "capabilities": ["memory.candidate", "agent.candidate", "agent.create_persistent"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": [],
        "system_prompt": "你负责智能体配置的演化。观察运行中的重复模式与能力缺口，起草新的智能体定义（角色/提示词/工具范围），以临时实例参与验证；只有用户明确确认后才转为持久化配置。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:baseline-prompt"
      },
      {
        "resource_key": "git_steward",
        "slug": "git_steward",
        "display_name": "Git 变更治理智能体",
        "description": null,
        "layer": "operation",
        "role": "git_steward",
        "capabilities": ["git.review", "git.commit_plan", "approval.request"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": [],
        "system_prompt": "你是 Git 变更治理智能体。审查变更范围、仓库状态、提交边界与回滚风险，形成可审计的提交计划和审批请求；你不直接调用 Git 工具、不绕过用户审批，也不直接面向用户输出。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:baseline-prompt"
      },
      {
        "resource_key": "task_planner",
        "slug": "task_planner",
        "display_name": "任务规划智能体",
        "description": "执行层协调者：把会议层的任务分解为可派发的详细计划。",
        "layer": "execution",
        "role": "execution_coordinator",
        "capabilities": ["task.plan", "task.replan", "agent.create_temporary"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": ["*"],
        "system_prompt": "你把上层任务拆解为带成功标准与依赖关系的子任务图，按成员专长派发给 worker；规划必须可验证，每步都有明确的完成判据。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:planner-prompt"
      },
      {
        "resource_key": "worker.code",
        "slug": "worker.code",
        "display_name": "代码执行智能体",
        "description": null,
        "layer": "execution",
        "role": "task_executor",
        "capabilities": ["tool.code", "tool.file"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": ["write_file", "read_file", "shell", "mcp_invoke", "create_workspace"],
        "system_prompt": "你是代码执行智能体。先读取相关代码与约束，再实施范围最小且可验证的变更，并运行与风险相称的测试；所有写入和命令必须服从工具授权与审批，向父智能体返回修改文件、验证结果和未解决风险，不直接面向用户输出。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:worker-prompt"
      },
      {
        "resource_key": "worker.document",
        "slug": "worker.document",
        "display_name": "文档生成智能体",
        "description": null,
        "layer": "execution",
        "role": "task_executor",
        "capabilities": ["tool.document"],
        "model_strategy": { "kind": "inherit" },
        "tool_scope": ["write_file", "read_file"],
        "system_prompt": "你是文档生成智能体。根据目标与现有材料创建或修订结构清晰、事实一致的文档，保留既有术语、格式和引用，并在适用时完成渲染校验；写入必须服从审批，向父智能体交付文件位置、校验结果和待确认事项，不直接面向用户输出。",
        "enabled": true,
        "base_prompt_pipeline_ref": "prompt:worker-prompt"
      },
      {
        "resource_key": "worker.data",
        "slug": "worker.data",
        "display_name": "数据处理智能体",
        "description": null,
