# vite-plugin-vue-mcp@0.3.2 的 peerDependencies 只声明到 vite@^6，
# 但本项目使用 Vite 7。其传递依赖（vite-dev-rpc / vite-hot-client）
# 实际兼容 Vite 7，因此跳过严格的 peer 校验以允许安装。
# 注意：legacy-peer-deps 下 npm 不会自动安装 peer 依赖，所以 react /
# react-dom / react-is 已作为显式依赖加入 apps/desktop/package.json，
# 否则全新环境 npm install 后这些 React 包会缺运行时依赖。
legacy-peer-deps=true
