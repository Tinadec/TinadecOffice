<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework (MAF) - keep the adapter package family on one stable baseline. -->
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.18.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.18.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.18.0" />

    <!-- Microsoft.Extensions.AI – stable -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />

    <!-- Anthropic Messages protocol client (community SDK; MessagesEndpoint implements IChatClient) -->
    <PackageVersion Include="Anthropic.SDK" Version="5.10.0" />

    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />

    <!-- Microsoft.Extensions (runtime packages use 10.0.x versioning, separate from AI packages) -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />

    <!-- Database abstraction (EF Core + SQLite default + PostgreSQL optional) -->
    <!-- Npgsql EF provider has no stable 11.0 yet; 11.0.0-rc.3 pins Relational to
         11.0.0-rc.3.26522.148, so the whole EF set stays on that exact build until
         Npgsql EF 11.0.0 GA ships. Then bump all of these to 11.0.0 together. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <!-- Pins SQLite native runtime above GHSA-2m69-gcr7-jv3q (CVE-2025-6965; SQLite < 3.50.2).
         EF Core.Sqlite 11 rc.3 requires >= 3.0.5, which already bundles SQLite >= 3.50. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" />

    <!-- F# core -->
    <PackageVersion Include="FSharp.Core" Version="9.0.303" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
  </ItemGroup>

</Project>
