<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TinadecCore.Runtime</RootNamespace>
    <Description>Runtime: full composition of all TinadecCore modules.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>TinadecCore.Runtime</PackageId>
    <PackageTags>tinadec;agent;runtime;dmaea;maf</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>tinadec-core-packaging.zh-CN.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\TinadecCore.Abstractions.csproj" />
    <ProjectReference Include="..\Contracts\TinadecCore.Contracts.csproj" />
    <ProjectReference Include="..\Persistence\TinadecCore.Persistence.csproj" />
    <ProjectReference Include="..\VectorStore\TinadecCore.VectorStore.csproj" />
    <ProjectReference Include="..\Tenancy\TinadecCore.Tenancy.csproj" />
    <ProjectReference Include="..\AgentConfiguration\TinadecCore.AgentConfiguration.csproj" />
    <ProjectReference Include="..\DmaEA\TinadecCore.DmaEA.csproj" />
    <ProjectReference Include="..\Models\TinadecCore.Models.csproj" />
    <ProjectReference Include="..\Context\TinadecCore.Context.csproj" />
    <ProjectReference Include="..\Prompts\TinadecCore.Prompts.csproj" />
    <ProjectReference Include="..\Memory\TinadecCore.Memory.csproj" />
    <ProjectReference Include="..\Skills\TinadecCore.Skills.csproj" />
    <ProjectReference Include="..\LoopGuard\TinadecCore.LoopGuard.csproj" />
    <ProjectReference Include="..\Lifecycle\TinadecCore.Lifecycle.csproj" />
    <ProjectReference Include="..\Governance\TinadecCore.Governance.csproj" />
    <ProjectReference Include="..\Tools\TinadecCore.Tools.csproj" />
    <ProjectReference Include="..\Storage.Migrations.Sqlite\TinadecCore.Storage.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Storage.Migrations.PostgreSql\TinadecCore.Storage.Migrations.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\tinadec-core-packaging.zh-CN.md" Pack="true" PackagePath="tinadec-core-packaging.zh-CN.md" />
    <None Include="Configuration\bootstrap-agent-directory.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
