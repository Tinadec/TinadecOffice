<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <RootNamespace>TinadecCore.Prompts</RootNamespace>
    <Description>Prompts: deterministic assembly of fragments, agent instructions, and skill contributions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\TinadecCore.Abstractions.csproj" />
    <ProjectReference Include="..\Strategies\TinadecCore.Strategies.fsproj" />
    <ProjectReference Include="..\Persistence\TinadecCore.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <!-- `PromptAssembler` stays internal, but its answer-depth rule is a behavioural
       contract worth pinning from the test side rather than only through a full host. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TinadecCore.Api.Tests" />
  </ItemGroup>

</Project>
