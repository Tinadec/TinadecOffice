<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <RootNamespace>TinadecCore.Lifecycle</RootNamespace>
    <Description>Lifecycle: run/task/agent/tool/approval state and audit events.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\TinadecCore.Abstractions.csproj" />
    <ProjectReference Include="..\Strategies\TinadecCore.Strategies.fsproj" />
    <ProjectReference Include="..\Persistence\TinadecCore.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <!-- The widget envelope rule decides what a tool may hand the renderer, so it is pinned from
       the test side rather than only exercised through a full run. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TinadecCore.Api.Tests" />
  </ItemGroup>

</Project>
