{
  "mcpServers": {
    "vue-mcp": {
      "type": "sse",
      "url": "http://localhost:5173/__mcp/sse"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn-vue@latest", "mcp"],
      "cwd": "apps/desktop"
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "electron": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "electron-mcp-server"],
      "env": {
        "SECURITY_LEVEL": "balanced"
      }
    }
  }
}
